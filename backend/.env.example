# Copy this file to backend/.env and fill in real values. backend/.env is gitignored.

# Postgres connection string for the accounts / session / gaze data.
DATABASE_URL=postgresql://user:password@localhost:5432/drivesim

# JWT signing secret. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-hex-string

# Anthropic API key for the coaching-report LLM calls (backend/coaching).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the coaching model (defaults to claude-haiku-4-5).
# ANTHROPIC_MODEL=claude-haiku-4-5

# Set to true ONLY when the backend runs behind a trusted reverse proxy / tunnel
# (e.g. Cloudflare Tunnel), so rate limiting keys on the real client IP from the
# CF-Connecting-IP / X-Forwarded-For header. Leave false for direct connections.
TRUST_PROXY_HEADER=false
